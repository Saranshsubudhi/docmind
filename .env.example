# Copy to .env.local and fill in. These are read on the server only —
# never prefix them with NEXT_PUBLIC_.

# --- Chat model (any OpenAI-compatible API) ---
# Default: NVIDIA Nemotron 3.5 Super VL on the free build.nvidia.com endpoint.
# Get a key (starts with nvapi-) at https://build.nvidia.com
# (NVIDIA_API_KEY also works as the variable name.)
OPENAI_API_KEY=nvapi-...
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
CHAT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Backup model, used automatically if CHAT_MODEL errors or sends nothing
# within CHAT_FIRST_TOKEN_TIMEOUT_MS (ms). Leave empty to disable.
CHAT_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
CHAT_FIRST_TOKEN_TIMEOUT_MS=20000
# Nemotron reasoning ("thinking") is off by default; set true to enable it.
CHAT_ENABLE_THINKING=false
# Maximum tokens per model reply.
CHAT_MAX_TOKENS=4096
# Fail a model call after this long (ms), retrying up to CHAT_MAX_RETRIES times.
CHAT_TIMEOUT_MS=60000
CHAT_MAX_RETRIES=2

# To use OpenAI instead:
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=
#   CHAT_MODEL=gpt-4.1-mini

# --- Embeddings (default to the chat provider above) ---
# "nvidia" or "openai". Auto-detected from the base URL when empty.
EMBEDDING_PROVIDER=
# NVIDIA default: nvidia/nemotron-3-embed-1b. OpenAI default: text-embedding-3-small.
EMBEDDING_MODEL=
# Only set these if embeddings come from a different provider than chat.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- Retrieval ---
# Number of chunks returned by search_docs (1-10).
RETRIEVAL_TOP_K=5
# Minimum cosine similarity for a chunk to count as relevant. Tune per embedding model.
RETRIEVAL_MIN_SCORE=0.3

# Optional: base URL used to build source links for docs in data/docs without a `url:` front matter field.
DOCS_BASE_URL=
